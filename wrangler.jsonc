{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wholesale",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.js",
  // Keep the variables and secrets set in the Cloudflare dashboard (DATABASE_URL, ADMIN_EMAILS…) on every deploy.
  "keep_vars": true,
  // ADMIN_EMAILS: emails that become admins when they sign in (comma-separated).
  // Public values (the publishable key is meant to be seen by browsers). DATABASE_URL stays a dashboard secret.
  "vars": {
    "ADMIN_EMAILS": "nurali.rustamov.projects@gmail.com",
    "VITE_SUPABASE_URL": "https://mkkgagnmbchyxgwjcqjl.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_kb5j9m24WtJSIWkcjpxXPg_K_Oik5vz"
  },
  // 19:00 UTC = 6:00 am in Sydney during daylight saving (5:00 am in winter).
  "triggers": { "crons": ["0 19 * * *"] },
  "observability": { "enabled": true }
}
