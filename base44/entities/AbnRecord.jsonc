{
  "name": "AbnRecord",
  "type": "object",
  "properties": {
    "abn": {
      "type": "string",
      "description": "Unique. Never deleted, so the free sample stays once per ABN for life"
    },
    "first_user_email": {
      "type": "string"
    },
    "join_free_sample_used": {
      "type": "boolean",
      "default": false
    },
    "used_on": {
      "type": "string",
      "format": "date"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}