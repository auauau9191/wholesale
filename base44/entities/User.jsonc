{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "hub_code": {
      "type": "string",
      "description": "Hub the staff member works from. ALL means every hub",
      "enum": [
        "BNE",
        "SYD",
        "ALL"
      ],
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "membership_active": {
      "type": "boolean",
      "description": "True while the member's plan is paid up. Written only by the server, never by the member",
      "default": false,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ]
}