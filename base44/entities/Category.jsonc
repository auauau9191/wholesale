{
  "name": "Category",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique short code, e.g. PC"
    },
    "name": {
      "type": "string"
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_live": {
      "type": "boolean",
      "default": false
    },
    "compliance_notes": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "membership_active": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}